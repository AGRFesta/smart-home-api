meta {
  name: Set AC Settings
  type: http
  seq: 2
}

patch {
  url: {{BASE_URL}}/devices/:uuid/air-conditioner
  body: json
  auth: inherit
}

params:path {
  uuid: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "power": "ON",
    "mode": "COOL",
    "targetTemperature": 22,
    "fanSpeed": "AUTO"
  }
}
